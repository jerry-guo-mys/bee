{
  "metadata": {
    "id": "code-analyzer",
    "name": "Code Analyzer",
    "version": "1.0.0",
    "description": "代码静态分析插件，支持复杂度分析、代码 smell 检测",
    "author": "Bee Team",
    "license": "MIT",
    "homepage": "https://github.com/bee/code-analyzer",
    "repository": "https://github.com/bee/code-analyzer",
    "keywords": ["code", "analysis", "static", "quality"],
    "categories": ["development", "analysis"],
    "dependencies": [],
    "capabilities": ["read_workspace", "analysis"],
    "configuration": {
      "max_file_size_kb": 1024,
      "supported_languages": ["rust", "typescript", "javascript", "python"],
      "enable_complexity_check": true,
      "enable_smell_check": true,
      "complexity_threshold": 10
    }
  },
  "files": [
    "src/main.rs",
    "src/analyzer.rs",
    "src/complexity.rs",
    "src/smells.rs"
  ],
  "entry_point": "src/main.rs",
  "signature": null,
  "api_version": "1.0.0",
  "config_schema": {
    "type": "object",
    "properties": {
      "max_file_size_kb": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10240,
        "default": 1024
      },
      "supported_languages": {
        "type": "array",
        "items": {"type": "string"},
        "default": ["rust", "typescript", "javascript", "python"]
      },
      "complexity_threshold": {
        "type": "integer",
        "minimum": 5,
        "maximum": 50,
        "default": 10
      }
    }
  }
}
