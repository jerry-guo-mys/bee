# 开发时代理（仅 Vite dev server 使用，见 vite.config.ts）
#
# bee-gateway 默认是 WebSocket（如 127.0.0.1:9000），不提供 bee-web 的 /api/metrics、/api/tasks 等 REST。
# 管理后台页面依赖这些 REST，因此 /api 应继续指向 bee-web。

# bee-web（全站）或 bee-admin（仅 /api 管理接口，默认 8081）
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8080
# 若只起 bee-admin：VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8081

# WebSocket：可改为 bee-gateway，例如 ws://127.0.0.1:9000
VITE_DEV_WS_PROXY_TARGET=ws://127.0.0.1:8080
